# Turso / libSQL connection for ManggalaOPS
# Copy this file to .env.local and fill the values.

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Operations toggles (production only). Leave commented unless explicitly needed.
# MANGGALA_ALLOW_RESET=true
# MANGGALA_ALLOW_SEED=true
